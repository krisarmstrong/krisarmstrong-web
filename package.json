{
  "name": "krisarmstrong-web",
  "version": "1.3.52",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "build:analyze": "ANALYZE=true npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "test:e2e": "playwright test",
    "test:e2e:krisarmstrong": "playwright test --project=krisarmstrong",
    "test:e2e:intrinsic": "playwright test --project=intrinsic",
    "test:e2e:wifivigilante": "playwright test --project=wifivigilante",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "lint": "biome check . && npm run typecheck --workspaces --if-present",
    "lint:fix": "biome check --write .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "audit:security": "npm audit --audit-level=moderate",
    "audit:ci": "npx audit-ci --moderate",
    "prepare": "husky",
    "release": "semantic-release",
    "release:dry": "semantic-release --dry-run",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc,css,md,yml,yaml}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@changesets/cli": "^2.31.0",
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/vite": "^4.2.4",
    "@types/node": "^25.6.2",
    "@vitejs/plugin-react": "^6.0.1",
    "audit-ci": "^7.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.2",
    "rollup-plugin-visualizer": "^7.0.1",
    "terser": "^5.47.1",
    "tsc-files": "^1.1.4",
    "turbo": "^2.9.10",
    "vite": "^8.0.11",
    "vitest": "^4.1.5"
  },
  "overrides": {
    "glob": "^13.0.0",
    "brace-expansion": "^2.0.2",
    "semver": "^7.6.3",
    "tar": "^7.5.2",
    "ip": "^2.0.1"
  }
}

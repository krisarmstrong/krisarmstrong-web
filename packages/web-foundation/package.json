{
  "name": "@krisarmstrong/web-foundation",
  "version": "0.9.12",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/krisarmstrong/web-foundation"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./src/test-utils": "./src/test-utils/index.ts",
    "./src/base.css": "./src/base.css",
    "./src/themes/wifivigilante.css": "./src/themes/wifivigilante.css",
    "./src/themes/intrinsic.css": "./src/themes/intrinsic.css",
    "./src/themes/krisarmstrong.css": "./src/themes/krisarmstrong.css"
  },
  "files": [
    "src",
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "build": "npm run clean && tsup --dts --sourcemap --format esm,cjs --out-dir dist --metafile",
    "dev": "tsup --dts --watch --format esm,cjs --out-dir dist",
    "lint": "biome check . && tsc --noEmit",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepare": "husky",
    "bundle:analyze": "esbuild-visualizer --metadata ./dist/metafile-esm.json --filename ./dist/bundle.html",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc,css,md,yml,yaml}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "peerDependencies": {
    "@sentry/react": "^10.52.0",
    "lucide-react": "^1.14.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.15.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@storybook/addon-docs": "^10.3.6",
    "@storybook/addon-onboarding": "^10.3.6",
    "@storybook/react-vite": "^10.3.6",
    "@tailwindcss/postcss": "^4.2.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.6.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/browser-playwright": "4.1.5",
    "@vitest/coverage-v8": "^4.1.5",
    "audit-ci": "^7.1.0",
    "esbuild-visualizer": "^0.7.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.2",
    "npm-run-all": "^4.1.5",
    "playwright": "^1.59.1",
    "postcss": "^8.5.14",
    "rimraf": "^6.1.3",
    "storybook": "^10.3.6",
    "tailwindcss": "^4.2.4",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "4.1.5"
  },
  "license": "MIT",
  "dependencies": {
    "clsx": "^2.1.1",
    "dompurify": "^3.4.2",
    "fuse.js": "^7.3.0"
  }
}

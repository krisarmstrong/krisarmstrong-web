# Application Environment (Optional)
VITE_APP_ENV=development

# Turso/libSQL database for live cases, ratings, and admin edits
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your-turso-token
ADMIN_API_TOKEN=change-this-long-random-admin-token

# Sentry Error Tracking (Optional - for production error monitoring)
# Sign up at https://sentry.io and create a project to get your DSN
VITE_SENTRY_DSN=https://your-key@sentry.io/your-project-id

# Analytics (Optional)
VITE_ENABLE_ANALYTICS=false

# Error Tracking Endpoint (Optional)
VITE_ERROR_TRACKING_ENDPOINT=

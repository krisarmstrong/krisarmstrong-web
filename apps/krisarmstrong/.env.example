# Contact form endpoint
VITE_FORMSPREE_ENDPOINT=https://formspree.io/f/your-form-id

# Sentry error tracking (optional)
# Sign up at https://sentry.io and create a project to get your DSN
VITE_SENTRY_DSN=https://your-sentry-dsn@sentry.io/your-project-id

# Plausible Analytics (optional)
# Privacy-friendly analytics - no cookies, GDPR compliant
# Sign up at https://plausible.io and add your domain
# The domain is configured directly in index.html (data-domain attribute)
VITE_PLAUSIBLE_DOMAIN=krisarmstrong.com

# Turso/libSQL database for live content, ratings, and admin edits
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your-turso-token
ADMIN_API_TOKEN=change-this-long-random-admin-token

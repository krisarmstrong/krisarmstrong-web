{
  "name": "krisarmstrong-org",
  "author": "Kris Armstrong",
  "private": true,
  "version": "0.8.6",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run blog:metadata && npm run sitemap && vite build",
    "preview": "vite preview",
    "test": "vitest --pool=threads",
    "test:ui": "vitest --ui --pool=threads",
    "test:coverage": "vitest --coverage --pool=threads",
    "version": "node scripts/update-version.mjs",
    "blog:metadata": "node scripts/generate-blog-metadata.js",
    "sitemap": "node scripts/generate-sitemap.js",
    "db:seed": "node scripts/seed-turso.js",
    "lint": "biome check . && tsc --noEmit",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@krisarmstrong/web-foundation": "^0.9.11",
    "@libsql/client": "^0.17.3",
    "@sentry/react": "^10.52.0",
    "@tanstack/react-query": "^5.100.9",
    "clsx": "^2.1.1",
    "docx": "^9.6.1",
    "dotenv": "^17.4.2",
    "file-saver": "^2.0.5",
    "framer-motion": "^12.38.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.14.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.15.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.4",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.2.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.6.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.5",
    "autoprefixer": "^10.5.0",
    "canvas": "^3.2.3",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.14",
    "tailwindcss": "^4.2.4",
    "typescript": "^6.0.3",
    "vite": "^8.0.11",
    "vitest": "4.1.5"
  }
}

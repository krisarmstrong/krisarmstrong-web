{
  "name": "intrinsicmomentummindset-com",
  "author": "Kris Armstrong",
  "private": true,
  "version": "0.3.2",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run sitemap && vite build",
    "lint": "biome check . && tsc --noEmit",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest --pool=threads",
    "test:ui": "vitest --ui --pool=threads",
    "test:coverage": "vitest --coverage --pool=threads",
    "sitemap": "node scripts/generate-sitemap.js"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc,css,md,yml,yaml}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "dependencies": {
    "@krisarmstrong/web-foundation": "^0.9.11",
    "@sentry/react": "^10.52.0",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.14.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.15.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.4",
    "@tailwindcss/vite": "^4.2.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.6.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/browser-playwright": "4.1.5",
    "@vitest/coverage-v8": "4.1.5",
    "autoprefixer": "^10.5.0",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.59.1",
    "postcss": "^8.5.14",
    "tailwindcss": "^4.2.4",
    "typescript": "~6.0.3",
    "vite": "^8.0.11",
    "vitest": "4.1.5"
  }
}
